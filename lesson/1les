CREATE DATABASE TestTableNovMat

USE [2026_IB_31]
CREATE TABLE Department(
  ID INT  IDENTITY(1,1) PRIMARY KEY,
  [Name]  NVARCHAR(150) NOT NULL
);

CREATE TABLE Position(
  Id INT IDENTITY(1,1) PRIMARY KEY,
  Title NVARCHAR(100) NOT NULL,
  Salary DECIMAL(15,2) NOT NULL 
      CHECK(Salary > 0)
);

CREATE TABLE StaffingTable(
  DepartmentID INT NOT NULL,
  PositionID INT NOT NULL FOREIGN KEY 
	    REFERENCES Position(id) ,
  Quantity INT NOT NULL DEFAULT(5)
	    CHECK(Quantity >0 AND Quantity<100),
  CONSTRAINT PK_StaffingTable PRIMARY KEY(DepartmentID, PositionID),
  CONSTRAINT FK_StaffingTable_Department 
	    FOREIGN KEY(DepartmentID)
	    REFERENCES Department(ID)
);
