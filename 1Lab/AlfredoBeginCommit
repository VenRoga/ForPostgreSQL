WITH 
inserted_item AS (
    INSERT INTO Item (item_type_id, item_percent_wear, item_summ, item_status, item_active_pawn_id)
    VALUES (1, 10, 25000.00, 'принято', NULL)
    RETURNING item_id 
),

inserted_pawn AS (
    INSERT INTO Pawn (pawn_client_id, pawn_item_id, pawn_sign_date, pawn_summ, pawn_comis, pawn_end_date, pawn_redemption_date)
    SELECT 
        1,               -- ID клиента (client_id)
        item_id,         -- Берем ID из предыдущего шага!
        '2026-03-16',    -- Дата заключения
        25000.00,        -- Сумма залога
        10,              -- Комиссия %
        '2026-04-16',    -- Дата окончания
        NULL             -- Дата выкупа (пока NULL)
    FROM inserted_item
    RETURNING pawn_id, pawn_item_id 
)

UPDATE Item 
SET item_active_pawn_id = inserted_pawn.pawn_id
FROM inserted_pawn
WHERE Item.item_id = inserted_pawn.pawn_item_id;
